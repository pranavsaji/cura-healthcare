# ── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4100
WEB_PORT=5173
API_URL=http://localhost:4100
WEB_ORIGIN=http://localhost:5173
# Set to `true` when web and API are on different sites (e.g. Vercel ↔ Railway)
# so the session cookie is issued SameSite=None; Secure. Leave false for local.
CROSS_SITE_COOKIES=false

# ── Database (Postgres) ───────────────────────────────────────────────
# Local: `docker run -e POSTGRES_PASSWORD=cura -p 5432:5432 postgres:16`
DATABASE_URL=postgres://postgres:cura@localhost:5432/cura

# ── Auth (WorkOS AuthKit) — optional in dev; falls back to a dev session ──
# AUTH_PROVIDER: mock (keyless dev session) | workos (hosted AuthKit login).
# For workos, register WORKOS_REDIRECT_URI in the WorkOS dashboard; it must point
# at THIS API's /auth/callback (not the web origin).
AUTH_PROVIDER=mock
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:4100/auth/callback

# ── Speech-to-text (ASR) ──────────────────────────────────────────────
# Providers: mock | deepgram | assemblyai. "mock" still supports real voice via
# the browser's on-device dictation; set deepgram + DEEPGRAM_API_KEY for real
# streaming ASR with speaker labels.
ASR_PROVIDER=mock
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# ── LLM (note generation) — leave the key blank to fall back to MOCK ─
# Providers: mock | anthropic | deepseek
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=deepseek-chat

# ── Object storage (audio) — local disk in dev ──────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=apps/api/.uploads
