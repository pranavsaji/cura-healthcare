# ── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4100
WEB_PORT=5173
API_URL=http://localhost:4100
WEB_ORIGIN=http://localhost:5173

# ── Database (Postgres) ───────────────────────────────────────────────
# Local: `docker run -e POSTGRES_PASSWORD=cura -p 5432:5432 postgres:16`
DATABASE_URL=postgres://postgres:cura@localhost:5432/cura

# ── Auth (WorkOS) — optional in dev; falls back to a dev session ──────
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:4100/auth/callback

# ── Speech-to-text (ASR) — leave blank to use the built-in MOCK ──────
# Providers: mock | deepgram | assemblyai
ASR_PROVIDER=mock
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# ── LLM (note generation) — leave blank to use the built-in MOCK ─────
# Providers: mock | anthropic
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-4-8

# ── Object storage (audio) — local disk in dev ──────────────────────
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=apps/api/.uploads
