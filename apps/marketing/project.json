{
  "name": "marketing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/marketing/app",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @cura/marketing dev" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @cura/marketing build" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @cura/marketing typecheck" }
    }
  }
}
