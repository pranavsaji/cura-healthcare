{
  "name": "@cura/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --outfile=dist/main.js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@fastify/websocket": "^11.0.1",
    "@cura/audit": "workspace:*",
    "@cura/auth": "workspace:*",
    "@cura/core": "workspace:*",
    "@cura/db": "workspace:*",
    "@cura/llm": "workspace:*",
    "@cura/notes": "workspace:*",
    "@cura/scribe": "workspace:*",
    "@cura/shared": "workspace:*",
    "@cura/telemetry": "workspace:*",
    "@cura/transcription": "workspace:*",
    "fastify": "^5.2.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^3.0.0",
    "ioredis": "^5.11.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "ws": "^8.21.0"
  }
}
