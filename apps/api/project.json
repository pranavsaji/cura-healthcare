{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @cura/api dev" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @cura/api build" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @cura/api typecheck" }
    }
  }
}
