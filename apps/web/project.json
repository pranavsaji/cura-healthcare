{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/web/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @cura/web dev" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @cura/web build" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @cura/web typecheck" }
    }
  }
}
