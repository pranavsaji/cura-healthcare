{
  "name": "cura",
  "version": "0.1.0",
  "private": true,
  "description": "Ambient AI operations platform for behavioral health — Curanote (scribe), Curadesk (front desk), Curabill (RCM).",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @cura/api --filter @cura/web dev",
    "dev:all": "pnpm --parallel --filter @cura/api --filter @cura/web --filter @cura/marketing dev",
    "dev:api": "pnpm --filter @cura/api dev",
    "dev:web": "pnpm --filter @cura/web dev",
    "dev:marketing": "pnpm --filter @cura/marketing dev",
    "build": "nx run-many -t build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests --exclude \"**/*.int.spec.ts\"",
    "test:unit": "vitest run --passWithNoTests --exclude \"**/*.int.spec.ts\"",
    "test:int": "vitest run --passWithNoTests int.spec",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage --exclude \"**/*.int.spec.ts\"",
    "test:security": "vitest run apps/api/test/authz-matrix.spec.ts apps/api/test/security-headers.spec.ts apps/api/test/phi-logs.spec.ts apps/api/test/fuzz.spec.ts test/security",
    "test:load": "vitest run test/load",
    "test:chaos": "vitest run test/chaos",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "pnpm --filter @cura/db generate",
    "db:migrate": "pnpm --filter @cura/db migrate",
    "db:studio": "pnpm --filter @cura/db studio"
  },
  "devDependencies": {
    "@cura/agents": "workspace:*",
    "@cura/audit": "workspace:*",
    "@cura/benefits": "workspace:*",
    "@cura/core": "workspace:*",
    "@cura/llm": "workspace:*",
    "@cura/scheduling": "workspace:*",
    "@cura/shared": "workspace:*",
    "@cura/telephony": "workspace:*",
    "@cura/voice": "workspace:*",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@testcontainers/postgresql": "^10.16.0",
    "@testcontainers/redis": "^10.16.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.17.0",
    "eslint-plugin-import": "^2.31.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "nx": "20.3.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.2.4"
  }
}
